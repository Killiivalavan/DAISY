# ==================================================
# DAISY Voice Assistant - Comprehensive .gitignore
# ==================================================

# ===== PYTHON ENVIRONMENT =====
# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
!.env.example
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
virtualenv/
venv310/

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ===== AI/ML MODELS AND CACHE =====
# Hugging Face transformers cache (auto-downloaded models)
models/models--*/
models/.locks/
src/voice/models/models--*/
src/voice/models/.locks/

# Large model binaries (>10MB)
*.bin
!models/hey-daisy_en_windows_v3_0_0.ppn
!models/*.ppn

# Model downloads and cache
.cache/
cache/
transformers_cache/
huggingface_hub/

# ===== VECTOR DATABASE AND RAG =====
# FAISS vector database (regenerated from documents)
vector_db/
!vector_db/README.md
!vector_db/.gitkeep

# Document processing tracking
document_tracking.json

# ===== AUDIO FILES AND CACHE =====
# TTS cache (temporary generated audio)
src/voice/cache/
cache/
*.wav
*.mp3
*.flac
*.ogg
!voice\ samples/
!voice\ samples/*.wav

# Recording files (temporary)
data/recording.wav
data/simple_recording.wav
data/*.wav
data/*.mp3

# ===== LOGS AND TEMPORARY FILES =====
# Application logs
*.log
logs/
speech_recognition.log

# Chat history backups
data/chat_history.json.backup
chat_history.json.backup

# Temporary files
temp_*
*.tmp
*.temp

# ===== DOCUMENTS (SIZE-BASED EXCLUSION) =====
# Large PDF files (>5MB) - users should manage their own documents
documents/**/*.pdf
!documents/**/README.md
!documents/**/*.txt
!documents/**/*.md

# Keep small documents and documentation
!documents/README.md

# ===== DATA DIRECTORY MANAGEMENT =====
# Keep structure but exclude large/temporary files
data/*
!data/README.md
!data/.gitkeep

# Exclude transcription and output files
transcription.txt
outputs/
checkpoints/

# ===== IDE AND SYSTEM FILES =====
# IDE specific files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Windows folder config files
Folder.jpg
AlbumArt_{*}.jpg
AlbumArtSmall.jpg

# ===== PROJECT SPECIFIC EXCLUSIONS =====
# Debug and test files
debug_*.py
test_output/
profiling_results/

# Backup files
*.backup
*.bak
original_*

# Environment and config
.env.local
.env.production
config.local.json

# ===== LARGE FILES SAFEGUARD =====
# Safeguard against any large files (>50MB)
# This is a catch-all for files that might slip through
**/large_files/
**/*_large.*
**/*.large

# Specific large file extensions
*.iso
*.dmg
*.tar.gz
*.zip
*.7z
*.rar 