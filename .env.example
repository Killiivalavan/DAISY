# DAISY Voice Assistant Environment Variables 
 
# Copy this file to .env and fill in your values 
# DO NOT commit your .env file to version control! 
 
# Picovoice Porcupine Wake Word Detection 
# Get your free access key at: https://console.picovoice.ai/ 
PORCUPINE_ACCESS_KEY=your_porcupine_access_key_here 
 
# Optional: Custom wake word model path (defaults to models/hey-daisy_en_windows_v3_0_0.ppn) 
# WAKE_WORD_MODEL_PATH=/path/to/your/custom_wake_word.ppn 
                            